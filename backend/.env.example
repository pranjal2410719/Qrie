# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Database Connection (Supabase / PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# JWT Authentication
JWT_SECRET=qrie_development_jwt_secret_must_be_at_least_32_characters_long!
JWT_ISSUER=qrie-auth
JWT_AUDIENCE=qrie-api

# LAM (Learning Adaptation Model) Integration
LAM_BASE_URL=http://localhost:8000
LAM_JWT_SECRET=staging_super_secret_jwt_key_at_least_32_characters_long!

# Day 2 relay: persistence is always on; forwarding to LAM is best-effort.
# Set to false for local work when no LAM service is running.
LAM_RELAY_ENABLED=true
LAM_TIMEOUT_MS=2000

# CORS – comma-separated list of origins allowed to make cross-origin requests.
# Required in production; leave empty in development to allow localhost on any port.
# Example: ALLOWED_ORIGINS=https://app.qrie.in,https://staging.qrie.in
ALLOWED_ORIGINS=
